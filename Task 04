})


# Prediction
new_prediction = loaded_model.predict(
    new_passenger
)

# Probability
new_probability = loaded_model.predict_proba(
    new_passenger
)[0]


print("\n" + "=" * 70)
print("NEW DATA PREDICTION")
print("=" * 70)

print("\nNew Passenger:")

display(new_passenger)

print(
    "Predicted Class:",
    new_prediction[0]
)

print(
    "Probability of Class 0:",
    round(new_probability[0], 4)
)

print(
    "Probability of Class 1:",
    round(new_probability[1], 4)
)


# ============================================================
# 37. FINAL SUMMARY
# ============================================================

print("\n" + "=" * 70)
print("PROJECT SUMMARY")
print("=" * 70)

print("Dataset                 : Titanic")
print("Problem Type            : Binary Classification")
print("Models Trained          : 4")
print("Models                  : Logistic Regression, Random Forest,")
print("                          XGBoost, SVM")
print("Cross Validation        : Stratified 5-Fold")
print("Hyperparameter Tuning   : GridSearchCV")
print("Primary CV Metric       : ROC-AUC")
print("Evaluation Metrics      : Accuracy, Precision, Recall, F1, ROC-AUC")
print("ROC Curves              : Generated")
print("Confusion Matrices      : Generated")
print("Champion Model          :", champion_name)
print(
    "Champion Validation AUC :",
    round(champion_search.best_score_, 4)
)
print(
    "Champion Test AUC       :",
    round(champion_auc, 4)
)
print("Serialized Model        :", model_filename)

print("\nPipeline completed successfully.")